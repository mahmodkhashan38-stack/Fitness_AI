# Fitness AI — environment variables
#
# Copy this file to `.env.local` (git-ignored) and adjust the values.
#
# IMPORTANT: every variable prefixed with VITE_ is embedded in the browser bundle
# and visible to anyone using the app. Never put secrets, API keys, database
# credentials or private tokens here.

# Base URL of the Fitness AI API. There is no backend yet, so this is empty.
# Examples:
#   VITE_API_BASE_URL=http://localhost:3000/api   (local backend during development)
#   VITE_API_BASE_URL=https://api.example.com/v1  (production; https is required)
#   VITE_API_BASE_URL=/api                        (same origin, behind a reverse proxy)
# When empty, the app still runs; API requests fail with an ApiError of kind "config".
VITE_API_BASE_URL=
