# Fitness AI — environment variables
#
# Copy this file to `.env.local` (git-ignored) and adjust the values.
#
# IMPORTANT: every variable prefixed with VITE_ is embedded in the browser bundle
# and visible to anyone using the app. Never put secrets, API keys, database
# credentials or private tokens here.

# Base URL of the Fitness AI API (backend/). Examples:
#   VITE_API_BASE_URL=/api                        (required for login: same origin, so the session
#                                                  cookie is first-party. Development: the Vite dev
#                                                  server proxies /api; production: the Cloudflare
#                                                  Worker forwards /api to Render)
#   VITE_API_BASE_URL=http://localhost:3000/api   (call the local backend directly; it must list
#                                                  http://localhost:5173 in its CORS_ORIGIN)
#   (Absolute URLs to another site still work for unauthenticated requests, but the session cookie
#    would be third-party and Safari blocks those, so authentication needs /api.)
# When empty, the app still runs; API requests fail with an ApiError of kind "config".
VITE_API_BASE_URL=/api

# Development only (not VITE_-prefixed, so never sent to the browser): where the Vite dev
# server forwards /api. Defaults to http://localhost:3000; change it if the backend PORT differs.
# DEV_API_PROXY_TARGET=http://localhost:3000
