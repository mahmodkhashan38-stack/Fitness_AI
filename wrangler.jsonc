// Cloudflare Workers deployment of the Fitness AI frontend (FIT-11).
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  // Must match the Worker's name in the Cloudflare dashboard (Workers Builds checks this).
  "name": "fitness-ai",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-20",
  // Keep the existing public URL https://fitness-ai.<account>.workers.dev (explicit; it is also the
  // default when no routes are configured).
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // Serve files exactly as named. The default ("auto-trailing-slash") answers /index.html with a
    // 307 to "/", which breaks the service worker install: Workbox precaches /index.html as the
    // offline app shell. "/" and client-side routes still get index.html from the SPA fallback.
    "html_handling": "none",
    // Unknown paths serve index.html (client-side routes, deep links).
    "not_found_handling": "single-page-application",
    // Only /api/* runs the Worker script (proxy to Render); static files stay free and unlimited.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Public, not a secret: the Render API origin (production service).
    "API_ORIGIN": "https://fitness-ai-api-5te2.onrender.com"
  },
  // Names only, never values. `wrangler deploy` fails while PROXY_SECRET is not set on the Worker,
  // so a deploy can never ship a proxy that Render would reject. Set the value in the dashboard
  // (Settings → Variables and Secrets → Add → type "Secret") or with
  // `npx wrangler secret put PROXY_SECRET` (prompts for the value; never pass it as an argument).
  // Secrets survive deploys; `vars` above replace dashboard variables on every deploy.
  "secrets": {
    "required": ["PROXY_SECRET"]
  }
}
