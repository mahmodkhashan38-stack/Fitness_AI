# Fitness AI backend — environment variables
#
# Copy to `backend/.env` (git-ignored) for local development.
# In production, set these in the hosting platform instead of a file.
# Never commit real values. These are server-side secrets: do NOT copy them into
# the frontend's VITE_* variables, which are public.

# HTTP port (default 3000).
PORT=3000

# development | test | production (default development).
NODE_ENV=development

# MongoDB connection string (required). From MongoDB Atlas:
#   Database → Connect → Drivers → copy the "mongodb+srv://" string,
#   replace <username>/<password> with a dedicated database user, and add a database name.
# Example (placeholders, not real credentials):
#   MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/fitness_ai?retryWrites=true&w=majority
MONGODB_URI=

# Comma-separated list of the app's browser origins (exact scheme://host[:port]). Used for CORS and
# as the CSRF allowlist: POST/PATCH/DELETE requests must come from one of these origins.
# Development default when empty: http://localhost:5173 and http://localhost:4173 (vite preview)
# Required in production, https only, no "*". Example: https://app.example.com
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Number of reverse proxies in front of the API whose X-Forwarded-For entries are trusted
# (used for the client IP in rate limiting). Default 0 = none (local development).
# Required in production. Render: 1. Never set it higher than the real number of proxies,
# or clients can spoof their IP.
# TRUST_PROXY_HOPS=0

# Shared secret between the Cloudflare Worker (which serves the app and forwards /api/*) and
# this API. When set, every request except GET /api/health must carry it, so the API can't be
# used directly. Required in production; optional locally (leave unset with the Vite proxy).
# At least 32 characters, e.g. `openssl rand -base64 48`. Never commit a real value.
# PROXY_SECRET=
